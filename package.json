{
  "name": "keel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "tokens:diff": "node scripts/tokens-diff.mjs",
    "icons": "node scripts/build-icons.mjs",
    "icons:import": "node scripts/import-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
